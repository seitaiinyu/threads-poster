[
 {
  "id": "18622775746025633",
  "text": "坐骨神経痛が治らない人の\n共通点3つ。",
  "ts": "2026-08-08T21:40:16+0000",
  "views": 11359
 },
 {
  "id": "17887555959599697",
  "text": "坐骨神経痛の回復が遅い人、\n神経の栄養が足りてないかもしれません",
  "ts": "2026-07-18T16:54:22+0000",
  "views": 9449
 },
 {
  "id": "18089834762648167",
  "text": "坐骨神経痛で“この感覚”が出たら、\nすぐ病院へ行ってください。",
  "ts": "2026-08-07T21:57:37+0000",
  "views": 6791
 },
 {
  "id": "18144935194539826",
  "text": "歩くと腰が痛くなるあなたへ。",
  "ts": "2026-07-22T15:36:43+0000",
  "views": 6692
 },
 {
  "id": "17981701901878206",
  "text": "坐骨神経痛の人の9割が\nやっていない、たった1つの習慣。",
  "ts": "2026-08-09T21:50:04+0000",
  "views": 6611
 },
 {
  "id": "18125582059743223",
  "text": "坐骨神経痛の人の9割が\nやっていない、たった1つの習慣。",
  "ts": "2026-07-26T17:07:40+0000",
  "views": 5994
 },
 {
  "id": "18082336232680039",
  "text": "坐骨神経痛で“この感覚”が出たら、\nすぐ病院へ行ってください。",
  "ts": "2026-08-01T22:13:21+0000",
  "views": 5522
 },
 {
  "id": "17942889927055832",
  "text": "坐骨神経痛の人の9割が\nやっていない、たった1つの習慣。",
  "ts": "2026-07-23T16:10:54+0000",
  "views": 5406
 },
 {
  "id": "17986221243014542",
  "text": "足首が硬い人、坐骨神経痛の回復が遅くなってます",
  "ts": "2026-07-23T16:01:57+0000",
  "views": 4996
 },
 {
  "id": "18096072701363784",
  "text": "坐骨神経痛で“この感覚”が出たら、\nすぐ病院へ行ってください。",
  "ts": "2026-07-22T16:21:10+0000",
  "views": 4926
 },
 {
  "id": "18011913917931365",
  "text": "坐骨神経痛で歩くのがつらい人、\n股関節の奥が固まってます",
  "ts": "2026-07-25T16:26:43+0000",
  "views": 4652
 },
 {
  "id": "18132691639720493",
  "text": "太もも裏が硬い人、\n坐骨神経痛が絶対に改善しません",
  "ts": "2026-07-18T15:36:59+0000",
  "views": 4493
 },
 {
  "id": "17941510908297448",
  "text": "坐骨神経痛で手術が必要なケースは、\n実はごく一部です。",
  "ts": "2026-08-06T14:52:52+0000",
  "views": 4137
 },
 {
  "id": "17864809311645833",
  "text": "坐骨神経痛で歩くのがつらい人、\n股関節の奥が固まってます",
  "ts": "2026-08-09T10:51:53+0000",
  "views": 4036
 },
 {
  "id": "18088453601134743",
  "text": "腰痛と「睡眠」の、\n知られていない関係。",
  "ts": "2026-07-27T15:43:26+0000",
  "views": 3941
 },
 {
  "id": "18149977129505770",
  "text": "水を飲まない人、\n椎間板が乾いて坐骨神経痛が悪化してます",
  "ts": "2026-07-18T15:57:08+0000",
  "views": 3452
 },
 {
  "id": "18088483946181303",
  "text": "坐骨神経痛が長引く人は、\n「呼吸」が浅くなっています。",
  "ts": "2026-08-13T22:02:08+0000",
  "views": 3432
 },
 {
  "id": "17888415594608125",
  "text": "レイクタウンのあたり、\n浸水被害ってありますか？",
  "ts": "2026-08-13T12:17:31+0000",
  "views": 3408
 },
 {
  "id": "17901260937514379",
  "text": "坐骨神経痛で手術が必要なケースは、\n実はごく一部です。",
  "ts": "2026-08-08T15:20:22+0000",
  "views": 3344
 },
 {
  "id": "18099235261961182",
  "text": "坐骨神経痛が治っても何度も再発してる人、\nやめてはいけないことがあります",
  "ts": "2026-07-18T16:32:44+0000",
  "views": 3299
 },
 {
  "id": "18101757968463840",
  "text": "くしゃみをした瞬間、\n腰に電気が走って\n動けなくなった。",
  "ts": "2026-08-09T15:33:45+0000",
  "views": 3245
 },
 {
  "id": "17977457214057738",
  "text": "立ち仕事で坐骨神経痛が悪化してる人、\n立ち方を変えるだけで変わります",
  "ts": "2026-07-19T15:37:20+0000",
  "views": 2962
 },
 {
  "id": "18160920736474939",
  "text": "反り腰で腰が痛くなるあなたへ。",
  "ts": "2026-08-08T15:31:38+0000",
  "views": 2947
 },
 {
  "id": "18099856055191806",
  "text": "お尻をほぐしても坐骨神経痛が\n改善しないあなたへ",
  "ts": "2026-07-26T16:49:21+0000",
  "views": 2855
 },
 {
  "id": "17873802339624079",
  "text": "坐骨神経痛のリハビリに水泳が最適な理由を知ってますか",
  "ts": "2026-07-18T16:25:45+0000",
  "views": 2854
 },
 {
  "id": "18101375993601799",
  "text": "なぜ、整形外科へ通っても\n坐骨神経痛が一向に良くならないか？\n解説します。",
  "ts": "2026-07-24T16:15:53+0000",
  "views": 2828
 },
 {
  "id": "17977928895055984",
  "text": "太もも裏が硬い人、\n坐骨神経痛が絶対に改善しません",
  "ts": "2026-07-25T16:51:02+0000",
  "views": 2803
 },
 {
  "id": "17892825537664609",
  "text": "腰痛の多くは、画像に原因が写らない\n「非特異的腰痛」だと言われています。",
  "ts": "2026-08-08T15:24:07+0000",
  "views": 2618
 },
 {
  "id": "17930652219366290",
  "text": "坐骨神経痛の人が、\n毎日やってはいけない座り方があります。",
  "ts": "2026-08-01T22:06:10+0000",
  "views": 2605
 },
 {
  "id": "17882932506610886",
  "text": "越谷の花火大会は、\n雷雨にならないですかね？",
  "ts": "2026-07-25T02:17:18+0000",
  "views": 2603
 }
]