[
 {
  "id": "18577573978068745",
  "text": "1日のうちで一番痩せるのは、\nいつだと思いますか。\n実は「寝ている間」です。",
  "ts": "2026-09-02T00:15:04+0000",
  "views": 38783
 },
 {
  "id": "18088041683196896",
  "text": "お腹がグーッと鳴った瞬間、\n体の中で何が起きているか\n知っていますか。",
  "ts": "2026-08-30T00:36:08+0000",
  "views": 10837
 },
 {
  "id": "18120769465868229",
  "text": "お腹がグーッと鳴った瞬間、\n体の中で何が起きているか\n知っていますか。",
  "ts": "2026-08-18T23:09:17+0000",
  "views": 8009
 },
 {
  "id": "17961093641979806",
  "text": "痩せない人の意外な共通点、\n「トイレの回数」です。",
  "ts": "2026-09-01T07:17:25+0000",
  "views": 5461
 },
 {
  "id": "17941368267315820",
  "text": "痩せないのは“腸”が原因かもしれません。",
  "ts": "2026-08-14T22:40:15+0000",
  "views": 2813
 },
 {
  "id": "17898091809498460",
  "text": "脂肪1kgを運動で燃やすには、\nフルマラソン3周が必要です。",
  "ts": "2026-09-03T00:16:14+0000",
  "views": 2630
 },
 {
  "id": "17890027290434972",
  "text": "「ちょこちょこ食べ」を続けると、\n血糖値の基準そのものが\n上がっていきます。",
  "ts": "2026-09-05T00:38:23+0000",
  "views": 2350
 },
 {
  "id": "18086980760242264",
  "text": "70歳のお客様が、\n8kg以上痩せました。\n運動は、していません。",
  "ts": "2026-09-03T00:31:52+0000",
  "views": 2293
 },
 {
  "id": "18349622074220519",
  "text": "体重計に「朝だけ」乗っていませんか。\n実は、それでは足りません。",
  "ts": "2026-08-20T23:12:27+0000",
  "views": 1894
 },
 {
  "id": "18125247910773107",
  "text": "糖質制限で痩せた人の顔を、\nよく見てください。",
  "ts": "2026-09-05T00:22:33+0000",
  "views": 1498
 },
 {
  "id": "18091331609423577",
  "text": "ダイエット中の人が、\n無意識に太らせている飲み物があります。",
  "ts": "2026-08-15T22:36:59+0000",
  "views": 1385
 },
 {
  "id": "18120675487900859",
