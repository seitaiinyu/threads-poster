[
 {
  "id": "18052827455739996",
  "text": "将来、高血圧、高コレステロールになって\n薬に年間10万以上、払いたいですか？\nお金に余裕があるんですね。",
  "ts": "2026-05-10T14:15:57+0000",
  "views": 529
 },
 {
  "id": "17885946573405930",
  "text": "血糖値スパイクを防ぐ食べ方5選",
  "ts": "2026-06-04T23:03:11+0000",
  "views": 515
 },
 {
  "id": "18046133585785077",
  "text": "お酒を飲んでも痩せる方法",
  "ts": "2026-05-10T12:04:56+0000",
  "views": 445
 },
 {
  "id": "17997324779939762",
  "text": "朝から夜は体重が増えます。\n＋400g以上なら、\nあなた食べ過ぎです。",
  "ts": "2026-05-09T09:52:52+0000",
  "views": 408
 },
 {
  "id": "18369825169161123",
  "text": "ダイエットが失敗する人の特徴3つ",
  "ts": "2026-05-09T09:43:55+0000",
  "views": 389
 },
 {
  "id": "18162522184387461",
  "text": "朝5分のストレッチで\n一日の代謝が変わるからやってみて！",
  "ts": "2026-05-08T22:21:53+0000",
  "views": 326
 },
 {
  "id": "18061966979449483",
  "text": "朝に味噌汁を飲むだけで\n腸内環境が整います。なぜかというと、、、",
  "ts": "2026-05-08T22:51:52+0000",
  "views": 322
 },
 {
  "id": "17912979669382085",
  "text": "内臓脂肪は皮下脂肪より\n落としやすいって知ってた？",
  "ts": "2026-05-05T13:59:04+0000",
  "views": 321
 },
 {
  "id": "18084415622620261",
  "text": "「痩せたら何でも食べていい」ではなく\n 「食べながら痩せる」が正解",
  "ts": "2026-05-06T09:55:51+0000",
  "views": 318
 },
 {
  "id": "17969435028019972",
  "text": "ストレスで食べてしまう人へ",
  "ts": "2026-05-10T11:34:51+0000",
  "views": 276
 },
 {
  "id": "17876493588458459",
  "text": "毎朝ヨーグルトを食べている人は\nダイエットにちょー不利です、、、",
  "ts": "2026-05-06T13:04:54+0000",
  "views": 276
 },
 {
  "id": "18578605813060255",
  "text": "GWに痩せる人は\n食べる量を減らしてるわけじゃない",
  "ts": "2026-05-05T11:23:51+0000",
  "views": 273
 },
 {
  "id": "18076506515219233",
  "text": "プロテインバーって\n糖質の塊って知ってた？",
  "ts": "2026-05-08T22:41:52+0000",
  "views": 268
 },
 {
  "id": "17863612776685206",
  "text": "運動ゼロ、カロリー計算なしで\n3ヶ月で7kg痩せるってズルいですか？",
  "ts": "2026-05-09T09:23:52+0000",
  "views": 235
 },
 {
  "id": "18114804358752049",
  "text": "白米だけの朝食が\n血糖値を爆上げします、、、",
  "ts": "2026-05-08T21:42:53+0000",
  "views": 234
 },
 {
  "id": "18092111675225111",
  "text": "食事を抜けば痩せると\n 思ってる人はダイエット失敗します",
  "ts": "2026-05-06T11:14:52+0000",
  "views": 234
 },
 {
  "id": "18123692683554927",
  "text": "薄着の季節ですね。\nあなたの体型、大丈夫ですか？",
  "ts": "2026-05-10T11:03:52+0000",
  "views": 233
 },
 {
  "id": "17990663651972327",
  "text": "毎日サラダ食べても痩せません。\n食べる順番はコレです。",
  "ts": "2026-05-09T03:00:55+0000",
  "views": 214
 },
 {
  "id": "18144124960499861",
  "text": "GWに痩せたいなら\n運動より先にやることはコレです",
  "ts": "2026-05-05T11:14:54+0000",
  "views": 202
 },
 {
  "id": "18083963714576319",
  "text": "白米が太る理由を\n正しく知ってる人っていますか？",
  "ts": "2026-05-09T09:00:54+0000",
  "views": 199
 },
 {
  "id": "17924582784318244",
  "text": "食べる量を減らしているのに\n痩せない理由TOP3",
  "ts": "2026-05-05T11:51:53+0000",
  "views": 198
 },
 {
  "id": "17990385512813887",
  "text": "「また明日からやろう」が口癖の人へ",
  "ts": "2026-06-17T21:48:57+0000",
  "views": 195
 },
 {
  "id": "18102772009983708",
  "text": "生理前に体重が増えるのは\n 食べすぎではありません。",
  "ts": "2026-05-06T22:31:57+0000",
  "views": 193
 },
 {
  "id": "18094937666327102",
  "text": "GW中に体重が落ちやすい\n意外な時間帯って知ってる？？",
  "ts": "2026-05-05T11:42:53+0000",
  "views": 192
 },
 {
  "id": "18018345704842789",
  "text": "【今すぐやめて】\n 太る夜食習慣\n 5選",
  "ts": "2026-06-06T13:13:53+0000",
  "views": 177
 },
 {
  "id": "18426331021192846",
  "text": "体重計を毎日見ることが\n ダイエット成功の最短ルートです。\nなぜなら、",
  "ts": "2026-05-05T13:44:07+0000",
  "views": 161
 },
 {
  "id": "18087423701340823",
  "text": "食事を減らしているのに\n 痩せない人がやっている\n 間違いはコレです。",
  "ts": "2026-05-06T11:03:59+0000",
  "views": 160
 },
 {
  "id": "18109031689709633",
  "text": "朝にたくさん食べると\n消化に体力を使いすぎます、、、",
  "ts": "2026-05-08T22:01:54+0000",
  "views": 159
 },
 {
  "id": "17931768486255336",
  "text": "1ヶ月で3kg減れば\n 夏に9kg痩せられるよ？",
  "ts": "2026-05-05T13:13:52+0000",
  "views": 158
 },
 {
  "id": "18123630553616096",
  "text": "週3でジム行ってるのに\r\n痩せないあなたへ。",
  "ts": "2026-05-09T09:11:52+0000",
  "views": 149
 }
]