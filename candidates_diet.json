[
 {
  "id": "18247694050305772",
  "text": "ダイエット中に体重が減らない人の\n 8割が、夜の体重を測ってない、、、",
  "ts": "2026-04-30T09:11:51+0000",
  "views": 2314
 },
 {
  "id": "17954936963962461",
  "text": "カロリー計算をやめたら、\r\n太ったあなたへ。",
  "ts": "2026-05-01T09:43:53+0000",
  "views": 2219
 },
 {
  "id": "18083078711377204",
  "text": "GWに痩せたいなら\n運動より先にやることはこれ。",
  "ts": "2026-05-02T22:41:54+0000",
  "views": 2172
 },
 {
  "id": "18157026550454422",
  "text": "GW中に水を飲むだけで\n 体重が落ちていく理由",
  "ts": "2026-05-02T11:51:53+0000",
  "views": 1575
 },
 {
  "id": "17889664425350814",
  "text": "生理前に体重が増えるのは\n 食べすぎではありません。",
  "ts": "2026-04-28T09:11:52+0000",
  "views": 1451
 },
 {
  "id": "18053778899711084",
  "text": "トイレの回数が1日10回未満の人は\n 体重が落ちにくい、、、",
  "ts": "2026-04-30T11:42:54+0000",
  "views": 1347
 },
 {
  "id": "18086656748368170",
  "text": "GW中に体重が落ちやすい\n 意外な時間帯があります",
  "ts": "2026-05-02T23:11:53+0000",
  "views": 1273
 },
 {
  "id": "18120385333572875",
  "text": "GW中に湯船に浸かるだけで\n 体重が落ちやすくなります",
  "ts": "2026-05-02T13:23:53+0000",
  "views": 1181
 },
 {
  "id": "17987708726985951",
  "text": "GW中に外食が続いても\n 痩せていく人の秘密",
  "ts": "2026-05-02T23:23:55+0000",
  "views": 1008
 },
 {
  "id": "17922819045123641",
  "text": "水を1日2L飲んでいる人と\n飲んでいない人では\n体重の落ち方に明確な差があった。",
  "ts": "2026-04-30T11:03:58+0000",
  "views": 985
 },
 {
  "id": "18088935098599356",
  "text": "お腹が鳴る前に食べてなら、\n痩せませんよ〜",
  "ts": "2026-04-28T21:56:54+0000",
  "views": 957
 },
 {
  "id": "18096701060115367",
  "text": "GWに甘いものを食べても\n 太らない食べ方があります",
  "ts": "2026-05-02T13:04:53+0000",
  "views": 941
 },
 {
  "id": "18586722877029467",
  "text": "夜ご飯、ちゃんとタンパク質とれてますか？\nここを外すと、痩せません。",
  "ts": "2026-04-29T11:23:53+0000",
  "views": 927
 },
 {
  "id": "18117359386679657",
  "text": "エステやマッサージで\n 体脂肪は落ちません。",
  "ts": "2026-05-01T22:02:55+0000",
  "views": 917
 },
 {
  "id": "17887623444480104",
  "text": "1日5回しかトイレに行かない人と\r\n10回以上行く人。\r\nどっちが痩せる？",
  "ts": "2026-05-01T11:14:53+0000",
  "views": 913
 },
 {
  "id": "18113821303699379",
  "text": "食べてすぐ寝てない？\nそれが脂肪になっていきます。",
  "ts": "2026-04-29T11:13:56+0000",
  "views": 886
 },
 {
  "id": "18308644309263063",
  "text": "40代以降は代謝が落ちるから\r\n痩せないはウソ。",
  "ts": "2026-04-29T23:25:53+0000",
  "views": 881
 },
 {
  "id": "17936663670237034",
  "text": "ダイエットが失敗する人の\n共通点はこれです。",
  "ts": "2026-05-04T14:15:57+0000",
  "views": 867
 },
 {
  "id": "18322736935250327",
  "text": "複数のダイエット法を試した人の\n 9割が思うような結果を出せていなかった。↓",
  "ts": "2026-04-30T13:32:53+0000",
  "views": 846
 },
 {
  "id": "18098729479930892",
  "text": "「水を飲むと太る」と\n 思っているなら、損してます、、、",
  "ts": "2026-05-04T11:32:58+0000",
  "views": 834
 },
 {
  "id": "18582388912021163",
  "text": "睡眠が6時間未満の人は\n 夜から翌朝の体重は減りません、、、",
  "ts": "2026-04-30T09:52:52+0000",
  "views": 763
 },
 {
  "id": "17950132707139300",
  "text": "「食べてないのに太る」の\n 本当の原因はこれ。",
  "ts": "2026-04-28T22:44:55+0000",
  "views": 757
 },
 {
  "id": "18094277819177235",
  "text": "シャワーだけで済ませている人は\n湯船に入る人より代謝が低いよ〜",
  "ts": "2026-04-30T13:04:56+0000",
  "views": 745
 },
 {
  "id": "18336273562216204",
  "text": "ダイエットの成功は\nこの臓器が重要です。それは",
  "ts": "2026-04-28T22:25:53+0000",
  "views": 740
 },
 {
  "id": "18201858841344890",
  "text": "夜遅くに食べている人が\n 痩せない仕組みを説明します。",
  "ts": "2026-04-28T13:43:22+0000",
  "views": 738
 },
 {
  "id": "18108805909852797",
  "text": "GW中に体重を増やさない人は\n 食事制限していません",
  "ts": "2026-05-02T13:44:00+0000",
  "views": 734
 },
 {
  "id": "17860283205586714",
  "text": "炭水化物をやめている人は\nリバウンド確定です。",
  "ts": "2026-04-28T11:45:51+0000",
  "views": 732
 },
 {
  "id": "18407634442178883",
  "text": "飲み会の翌朝に増えた体重の\n 9割は脂肪じゃないよ。",
  "ts": "2026-04-30T09:00:58+0000",
  "views": 728
 },
 {
  "id": "18048371804750249",
  "text": "40代以降、痩せなくなったあなたは\nこの方法で痩せてください。",
  "ts": "2026-05-01T11:34:52+0000",
  "views": 656
 },
 {
  "id": "18161180263442135",
  "text": "体重が同じでも体型が大きく変わった人が\n ダイエット成功者の中に多くいた。↓",
  "ts": "2026-04-30T21:42:52+0000",
  "views": 656
 }
]